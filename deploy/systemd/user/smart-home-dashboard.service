[Unit]
Description=Smart Home Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/orangepi/smart_home_AI
Environment=HOST=0.0.0.0
Environment=PORT=8000
ExecStart=/home/orangepi/smart_home_AI/scripts/run-dashboard.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
