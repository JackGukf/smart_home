# chip-tool session state (Matter commissioning credentials)
.chip-tool/

# Vendor auth artifacts saved as images. A Tuya "qrLogin" QR encodes a token
# that authorizes a login session on the account — short-lived, but never
# commit one. Decode before assuming an innocuous-looking PNG is a screenshot.
*authorization*.png
*qr-login*.png
*qrlogin*.png

# Personal remote-desktop profiles (per-machine host/user, not project config)
*.rdp

# Logs and runtime data
*.log
logs/
*.db
*.sqlite
*.sqlite3

# Editor and local workspace metadata
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
.codex/
.DS_Store
Thumbs.db
.worktrees

# Per-machine registry of Home Assistant entities already surfaced on the
# dashboard; seeded from the local HA instance, must not be shared across machines.
home_assistant_known_entities.json
dashboard_areas.json

# SDD scratch: task briefs, reports, review packages (may contain device ids)
.superpowers/
