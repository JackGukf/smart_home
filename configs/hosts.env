# The one place the deployment targets are written down.
#
# Change an address here and every script, both boards and the wall panel follow.
# Nothing else in this repo should contain a board IP address: if you find
# yourself typing one into a script, add it here instead.
#
# Why this file exists: on 2026-09-12 the Orange Pi moved from Wi-Fi to Ethernet
# and its address changed. Thirty-four files had to be edited, the wall panel sat
# on a dead URL, two Matter services ran `active` while bound to an interface
# that no longer existed, and every camera on the dashboard broke. One address,
# written down once, would have been one edit.
#
# These are plain `KEY=value` lines - no quoting, no expansion, no comments after
# a value - because both a shell and a Python parser have to agree on them.
#
# Everything here can still be overridden per-invocation, and that wins:
#   PI_HOST=192.168.0.99 ./scripts/deploy-dashboard.sh
#   ./scripts/deploy-to-pi.sh --host 192.168.0.99

# Orange Pi 6 Plus - the primary target, and the machine that runs the house.
# This is a DHCP lease. Give it a reservation on the router.
PI_HOST=192.168.0.83
PI_USER=orangepi
REMOTE_PATH=/home/orangepi/smart_home_AI

# Raspberry Pi 4 - secondary build target, and the wall panel since 2026-09-10.
# Its address is a credential: it logs itself into the dashboard and Home
# Assistant by IP. See docs/kiosk-display.md before changing it.
RPI4_HOST=192.168.0.176
RPI4_USER=smarthome
RPI4_REMOTE_PATH=/home/smarthome/smart-home-rpi4

# The dashboard the wall panel displays, and where go2rtc answers. Cameras do
# not need an address at all - `go2rtc_url: auto` in devices.local.yaml resolves
# to whatever the board's address currently is.
DASHBOARD_PORT=8000
