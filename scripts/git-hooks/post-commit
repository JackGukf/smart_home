#!/usr/bin/env bash
# Deploy what the commit changed to the Orange Pi (scripts/deploy.py): the
# changed files under src/python/, scripts/ and deploy/systemd/user/, restarting
# only the services that use them; dashboard changes go through
# deploy-dashboard.sh as before. Installed by scripts/install-git-hooks.sh.
#
# Non-fatal: a failed deploy never undoes the commit. The build-metadata commit
# that deploy-dashboard.sh leaves behind is made with hooks off:
#   git -c core.hooksPath=/dev/null commit -m "chore: record dashboard build cache-busting metadata"
REPO_ROOT="$(git rev-parse --show-toplevel)"
python3 "${REPO_ROOT}/scripts/deploy.py" --range HEAD~1..HEAD || {
    echo "[post-commit] Deploy did not finish (the commit stands). See above; re-run: scripts/deploy.py" >&2
}
