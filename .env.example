# Local Orange Pi 6 Plus dashboard secrets.
# Copy to .env on the Pi and fill with local camera and cloud credentials.
TAPO_CAMERA_USERNAME=replace_me
TAPO_CAMERA_PASSWORD=replace_me
WYZE_RTSP_USERNAME=replace_me
WYZE_RTSP_PASSWORD=replace_me
CHORTAU_CAMERA_USERNAME=replace_me
CHORTAU_CAMERA_PASSWORD=replace_me

# Tuya IoT Cloud credentials. Region examples: us, eu, cn, in.
TUYA_ACCESS_ID=replace_me
TUYA_ACCESS_SECRET=replace_me
TUYA_API_REGION=us
TUYA_ENDPOINT=
# Optional but useful for TinyTuya Cloud projects; use any linked Tuya device ID.
TUYA_DEVICE_ID=replace_me

# Home Assistant
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# Ecobee
ECOBEE_ACCESS_TOKEN=
ECOBEE_REFRESH_TOKEN=

# Dashboard auth
DASHBOARD_SECRET_KEY=changeme

# Bluetooth adapter used for BLE devices (Govee strips).
# Accepts an hciN name or a MAC address. Prefer the MAC: hciN numbering is
# assigned in probe order and can change across reboots when the host has more
# than one adapter. Leave unset to use the first adapter found.
# The Orange Pi 6 Plus has an onboard Intel controller plus the TP-Link UB500;
# this pins BLE to the UB500. List adapters with: hciconfig -a
BLE_ADAPTER=20:E1:5D:68:2B:DB

# Stable by-id path of the Zigbee coordinator (Sonoff ZBDongle-P).
# Written by scripts/install-zigbee2mqtt.sh; docker-compose.zigbee.yml maps it
# onto /dev/ttyACM0 inside the container. Always the /dev/serial/by-id/ path,
# never /dev/ttyUSB0 — USB enumeration order changes across reboots on a host
# with several USB devices, exactly like the hciN numbering BLE_ADAPTER avoids.
# List candidates with: ls -l /dev/serial/by-id/
ZIGBEE_ADAPTER=/dev/serial/by-id/replace_me

# Timezone for the Zigbee stack containers.
TZ=America/Vancouver
